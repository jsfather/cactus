DATABASE_URL=postgresql://cactus:change-me@localhost:5432/cactus
DATABASE_POOL_MAX=10
DATABASE_SSL=disable
RUN_MIGRATIONS=true
UPLOAD_DIR=.data/uploads

# Used only when no administrator account exists.
ADMIN_MOBILE=09121234567
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-8-characters
ADMIN_NAME_FA=همکار کاکتوس
ADMIN_NAME_EN=Cactus Administrator
# Optional split-name overrides. Existing ADMIN_NAME_* variables remain supported.
ADMIN_FIRST_NAME_FA=همکار
ADMIN_LAST_NAME_FA=کاکتوس
ADMIN_FIRST_NAME_EN=Cactus
ADMIN_LAST_NAME_EN=Administrator

# Mobile OTP. Use "console" only for local development; production must use Kavenegar.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=verify
AUTH_OTP_SECRET=replace-with-a-long-random-secret
# Public origin used for canonical links, Open Graph metadata, robots, and sitemap URLs.
SITE_URL=http://localhost:3000

# Optional ZarinPal v4 merchant identifier. Prices are converted from toman to IRR.
# Without this, orders can be placed but online payment is unavailable.
ZARINPAL_MERCHANT_ID=
