DATABASE_URL=postgresql://cactus:change-me@localhost:5432/cactus
DATABASE_POOL_MAX=10
DATABASE_SSL=disable
RUN_MIGRATIONS=true
UPLOAD_DIR=.data/uploads

# Used once to create the first administrator if the email does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME_FA=مدیر کاکتوس
ADMIN_NAME_EN=Cactus Administrator
# Optional split-name overrides. Existing ADMIN_NAME_* variables remain supported.
ADMIN_FIRST_NAME_FA=مدیر
ADMIN_LAST_NAME_FA=کاکتوس
ADMIN_FIRST_NAME_EN=Cactus
ADMIN_LAST_NAME_EN=Administrator
